# ---------------------------------------------------------------
# IL-TOD (ИЛ ТОД) environment variables. Copy to `.env` and fill in.
# Never commit real values. GitHub Actions reads the same names
# from repository secrets.
# ---------------------------------------------------------------

# Supabase PostgreSQL. In the dashboard click "Connect" (top of the project page),
# or open https://supabase.com/dashboard/project/<ref>?showConnect=true&method=transaction
# and copy the "Transaction pooler" string (port 6543, IPv4). Replace [YOUR-PASSWORD];
# percent-encode special characters (# → %23, @ → %40, & → %26, ? → %3F).
# postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=""
# Optional, for migrations in GitHub Actions: the "Session pooler" string (same host, port 5432).
# DATABASE_URL_DIRECT=""
# A database outside Supabase: its root certificate (PEM text or a file path); TLS stays verified.
# DATABASE_SSL_CA=""
# DB_POOL_MAX="3"              # connections per process (Supabase Free pooler is small)

# ---- AI providers --------------------------------------------------------------
# Free tiers are tried first; any ONE key is enough to run the pipeline.
# Order (override with AI_TIER1_CHAIN / AI_TIER2_CHAIN, comma separated):
#   tier1 (every article): groq, nvidia, requesty, openrouter (taking turns), zai, gemini, deepseek, ollama
#   tier2 (risk >= 65):    grok, groq, nvidia, requesty, openrouter, zai, gemini, deepseek, ollama
#   (a Gemini key from a project WITHOUT billing, GEMINI_FREE_TIER=true, moves up to second place)
# AI_TIER1_CHAIN="groq,nvidia,requesty,openrouter,zai,gemini,deepseek,ollama"
# AI_TIER2_CHAIN="grok,gemini,groq,nvidia,requesty,openrouter,zai,deepseek,ollama"

# Groq (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=""
# GROQ_MODEL="qwen/qwen3.8-27b"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_FREE_TIER="true"      # the key is from a Google project WITHOUT billing: free, keeps its place
# GEMINI_MODEL="gemini-flash-lite-latest"      # bulk (a billed key only ever uses a Flash-Lite model)
# GEMINI_DEEP_MODEL="gemini-flash-latest"      # deep analysis
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# ElevenLabs (video narration only, paid monthly plan; paced to last the month, else Gemini voices it)
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID="dJy4ovDyOEaI4kHP7CFP"   # Sukh (a key saved under this name counts as the key)
# ELEVENLABS_SECRET_VOICE_ID=""                # Actions only: the secret of the same name (key or voice id)
# ELEVENLABS_MODEL="eleven_v4"
# ELEVENLABS_RESERVE_CHARS="5000"              # credits left for the owner's own use
# ELEVENLABS_PLAN_USD="6"                      # the plan's monthly price, for the USD column of the ledger

# Requesty gateway: https://app.requesty.ai (default model is free; others bill your credit)
REQUESTY_API_KEY=""
# REQUESTY_MODEL="google/gemma-4-31b-it"
# REQUESTY_BASE_URL="https://router.requesty.ai/v1"

# NVIDIA NIM (free API, slower): https://build.nvidia.com
NVIDIA_API_KEY=""
# NVIDIA_MODEL="google/gemma-4-31b-it"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Mistral (opt-in: its free plan answers 429 since Aug 2026). A pay-as-you-go key bills: add
# "mistral" to AI_TIER1_CHAIN and set MISTRAL_PRICE_IN / MISTRAL_PRICE_OUT so the budget sees it.
MISTRAL_API_KEY=""
# MISTRAL_MODEL="mistral-small-latest"
# MISTRAL_BASE_URL="https://api.mistral.ai/v1"
# MISTRAL_PRICE_IN="0.1"
# MISTRAL_PRICE_OUT="0.3"

# OpenRouter free models (50 calls/day, no card): https://openrouter.ai/keys
# Only ids ending in ":free" are used; any other OPENROUTER_MODEL is ignored.
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Z.ai GLM Flash (free, one request at a time): https://z.ai
# Only the free "-flash" models are used (FlashX and larger GLM models bill).
ZAI_API_KEY=""
# ZAI_MODEL="glm-4.7-flash"
# ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# ---- Spending limits (paid providers only; free ones keep working) ---------------
# AI_MONTHLY_BUDGET_USD="3"
# AI_DAILY_BUDGET_USD="0.3"
# Daily call caps per provider (<PROVIDER>_DAILY_MAX_CALLS) and requests per minute (<PROVIDER>_RPM)
# GROK_DAILY_MAX_CALLS="5"
# DEEPSEEK_DAILY_MAX_CALLS="500"
# GEMINI_DAILY_MAX_CALLS="800"
# GROQ_DAILY_MAX_CALLS="1000"
# NVIDIA_DAILY_MAX_CALLS="1000"
# REQUESTY_DAILY_MAX_CALLS="1000"
# OPENROUTER_DAILY_MAX_CALLS="45"              # the free plan allows 50
# ZAI_DAILY_MAX_CALLS="1000"
# MISTRAL_DAILY_MAX_CALLS="1000"
# OLLAMA_DAILY_MAX_CALLS="100000"
# ELEVENLABS_DAILY_MAX_CALLS="6"               # video narrations a day (the rest fall back to Gemini)
# GEMINI_RPM="10"
# GROQ_RPM="25"
# NVIDIA_RPM="30"
# REQUESTY_RPM="30"
# OPENROUTER_RPM="10"
# ZAI_RPM="5"
# MISTRAL_RPM="1"
# AI_CONCURRENCY="3"
# AI_RATE_LIMIT_WAIT_MS="20000"                # one wait after a free provider's 429 before paying

# Paid: DeepSeek (bulk extraction / summarization)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"   # override for proxies/tests

# Paid: xAI Grok (deep investigative analysis on high-risk items, 5 calls/day by default)
GROK_API_KEY=""
# Check https://docs.x.ai/docs/models for current model ids.
GROK_MODEL="grok-4-fast"
# GROK_BASE_URL="https://api.x.ai/v1"

# Local Ollama fallback (zero cost, dev machines only).
# Leave empty in CI: the fallback is only used when this is set.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3.5:4b"

# Optional price overrides in USD per 1M tokens (defaults live in src/lib/ai/pricing.ts)
# DEEPSEEK_PRICE_IN="0.15"
# DEEPSEEK_PRICE_OUT="0.60"
# GROK_PRICE_IN="2"
# GROK_PRICE_OUT="6"

# Headless Chromium (the scraper's browser pass, the videos, the layout scan).
# Leave CHROMIUM_EXECUTABLE_PATH empty to use Playwright's own browser
# (`npx playwright install chromium`). Set SCRAPER_BROWSER=0 to disable the scraper's pass.
CHROMIUM_EXECUTABLE_PATH=""
# CHROMIUM_PATH=""             # the old name of the same setting (still read, with a warning)
SCRAPER_BROWSER="1"

# Web Push: public VAPID key (the pair is stored in the app_settings table; see CLAUDE.md §6).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_SUBJECT="https://iltodmedee.mn"
# PUSH_IMPORTANCE_MIN="70"     # importance needed for a "new news" notification
# PUSH_NEW_PER_HOUR="500"      # new subscriptions accepted per hour (the free database must not fill)
# PUSH_MAX_SUBSCRIPTIONS="50000"
# QUERY_TIMEOUT_MS="10000"     # public pages render the empty state instead of hanging
# FEED_MIN_IMPORTANCE="25"     # stories below it stay off the feeds (/topic/risk and /topic/data excepted)
# RETENTION_DAYS="180"         # db:prune: bodies older than this are cut to an excerpt

# Admin panel (/admin) password. Use a long random string.
ADMIN_SECRET_PASSWORD=""

# Public site settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # production: https://iltodmedee.mn
# Google Search Console / Bing Webmaster "HTML tag" verification codes (content="..." only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------------------------
# Optional features. Values never go in this file or in git: set them as GitHub Actions
# secrets/variables or on Vercel only where you use the feature (CLAUDE.md §7–§8).

# Social posting (docs/FACEBOOK.md)
# FB_PAGE_TOKEN=""             # never-expiring Page token
# FB_PAGE_ID=""                # optional: a Page token's /me is the page
# FB_GRAPH_VERSION="v26.0"
# IG_GRAPH_VERSION="v26.0"
# FB_IMPORTANCE_MIN="75"
# FB_NEWS_PER_RUN="1"
# FB_NEWS_PER_DAY="4"
# INSTAGRAM_TOKEN=""           # seeds the 60-day token kept in app_settings
# IG_APP_SECRET=""             # Instagram DM webhook signatures
# THREADS_TOKEN=""             # seeds the 60-day token kept in app_settings
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID="@channel"
# DISCORD_BOT_TOKEN=""
# DISCORD_CHANNEL_ID=""        # the id or the channel URL
# DISCORD_PUBLIC_KEY=""        # Vercel: slash-command signatures (/api/discord)
# MESSENGER_SETTINGS=""        # Vercel: JSON {pageId, pageToken, appSecret, verifyToken}

# Videos (CLAUDE.md §7c)
# VIDEO_POSTING="on"           # repository variable; "off" stops the daily videos
# VIDEO_MUSIC="on"             # "off" drops the synthesized beat
# GEMINI_TTS_MODEL="gemini-3.8-flash-tts"
# GEMINI_TTS_VOICE="Aoede"

# Watchdog (set by watchdog.yml, booleans only; HEALTH_SKIP_NETWORK=1 for a local run)
# SOCIAL_FACEBOOK="false"
# SOCIAL_INSTAGRAM="false"
# SOCIAL_THREADS="false"
# SOCIAL_TELEGRAM="false"
# SOCIAL_DISCORD="false"
# BACKUP_CONFIGURED="false"
# HEALTH_SKIP_NETWORK="1"
# GH_TOKEN=""                  # Actions: github.token, for the workflow checks
# LAYOUT_REPORT="layout.json"  # scripts/check-layout.ts --report file, read by the health check
# TAX_REPORT="tax-rates.md"    # written by the health check for the tax-rates issue

# Vercel deployment cleanup (vercel-cleanup.yml)
# VERCEL_TOKEN=""
# VERCEL_TEAM_ID=""
# VERCEL_PROJECT_ID=""
# VERCEL_KEEP_PRODUCTION="3"   # newest ready production deployments kept
