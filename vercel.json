{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "gemini/**": false,
      "dependabot/**": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)tests' ':(exclude)scripts' ':(exclude).github' ':(exclude).claude' ':(exclude)*.md'"
}
